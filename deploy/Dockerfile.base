FROM rayproject/ray:2.55.1-py312

WORKDIR /app


USER root
RUN apt-get update && apt-get install -y \
build-essential \
&& rm -rf /var/lib/apt/lists/*

USER ray

# constraints.txt pins protobuf==4.25.8 so serve_requirements.txt's deps can't
# bump protobuf past 4.x (breaks Ray Serve's _proto_to_dict). See the file.
COPY constraints.txt /app
COPY serve_requirements.txt /app
RUN pip install --no-cache-dir -c /app/constraints.txt -r serve_requirements.txt

# HuRI itself: huri-core + the curated events and modules (packages/), as
# installed distributions — that is how the server finds them (entry points).
# Built from a copy the build user owns, since pip builds local projects in
# place; the script fails the build if modules and events do not fit together.
COPY --chown=ray pyproject.toml README.md LICENSE /tmp/huri-src/
COPY --chown=ray huri_core /tmp/huri-src/huri_core
COPY --chown=ray packages /tmp/huri-src/packages
COPY --chown=ray deploy/install_huri.sh /tmp/huri-src/
RUN sh /tmp/huri-src/install_huri.sh /tmp/huri-src && rm -rf /tmp/huri-src
